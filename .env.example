# AUReviews environment — copy to .env.local for local dev and fill in.
# On Vercel, set these in Project Settings → Environment Variables instead.
# The Vercel–Neon integration populates the two connection strings for you.

# --- Neon Postgres (see docs/v1-spec.md §8) ---
# POOLED endpoint (PgBouncer): used by the app and Auth.js at runtime.
# Host contains "-pooler". Include ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT (non-pooled) endpoint: used by migrations (drizzle-kit) only.
# Same host WITHOUT "-pooler".
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- On-demand revalidation (see docs/v1-spec.md §8) ---
# Shared secret the internal /api/revalidate endpoint requires as a bearer token.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET="change-me-to-a-long-random-string"

# --- Auth: @auburn.edu sign-in code (see docs/v1-spec.md §7, issues #19/#43) ---
# Auth.js secret — also what sign-in codes are hashed with before storage, so
# the in-process exchange (src/auth/exchange.ts) needs it. Generate with:  npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="change-me-to-a-long-random-string"

# HMAC pepper for identity_hash = HMAC_SHA256(PEPPER, normalize(email)).
# MUST live here / in the platform secret store — NEVER in the database (§7).
# It is the ONLY thing making identity_hash non-reversible; treat it like a
# private key and do not rotate casually (rotation orphans existing identities).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PEPPER="change-me-to-a-long-random-secret"

# Resend delivery (§7). When RESEND_API_KEY is unset, sign-in codes are logged to
# the server console instead of sent — fine for local dev, never for production.
RESEND_API_KEY=""
# From-address on the dedicated sending subdomain with SPF+DKIM+DMARC published
# (a DNS launch-checklist item, §7). Must be a domain verified in Resend.
EMAIL_FROM="AUReviews <no-reply@mail.aureviews.com>"

# Auth.js is auto-detected on Vercel. For other hosts, set the canonical URL and
# trust the host header:
# AUTH_URL="https://aureviews.com"
# AUTH_TRUST_HOST="true"

# --- Catalog refresh script (npm run refresh; see docs/deploy.md §9, issue #30) ---
# Deployment origin the script pings after an import so cached pages refresh.
# In GitHub Actions this is a repo variable; set SKIP_REVALIDATE=1 to skip locally.
AUREVIEWS_BASE_URL="https://aureviews.vercel.app"

# --- Operator inbox (see docs/v1-spec.md §12, issue #27) ---
# Where "Report this review" notifications are sent.
# Unset = the row is still written, the email is logged with a warning instead.
OPERATOR_EMAIL=""
