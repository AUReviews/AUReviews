# AUReviews environment — copy to .env.local for local dev and fill in.
# On Vercel, set these in Project Settings → Environment Variables instead.
# The Vercel–Neon integration populates the two connection strings for you.

# --- Neon Postgres (see docs/v1-spec.md §8) ---
# POOLED endpoint (PgBouncer): used by the app and Auth.js at runtime.
# Host contains "-pooler". Include ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT (non-pooled) endpoint: used by migrations (drizzle-kit) only.
# Same host WITHOUT "-pooler".
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- On-demand revalidation (see docs/v1-spec.md §8) ---
# Shared secret the internal /api/revalidate endpoint requires as a bearer token.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET="change-me-to-a-long-random-string"
